# Na Vercel, estas variáveis já são criadas pelas integrações Neon e Blob (aba Storage).
# Só copie para .env.local se for rodar o site no seu computador.
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
NEXT_PUBLIC_SITE_URL=https://www.tiagogaze.com.br
# Opcional: chave própria para assinar o login. Sem ela, o site usa uma derivada do DATABASE_URL.
AUTH_SECRET=
